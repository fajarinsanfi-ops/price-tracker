# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Server-only key. Never expose this in client/browser code.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEMPLATE_NAME=price_drop_alert
WHATSAPP_TEMPLATE_LANGUAGE=id

# Optional worker behavior
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2
USER_AGENT=PersonalPriceTracker/0.1 (personal use; contact: set-your-email)
TIMEZONE=Asia/Jakarta
