# Supabase project URL
SUPABASE_URL=https://kdsqrqrduziqcurmrphl.supabase.co

# Current server-only Supabase key. Never expose this in client/browser code.
# Store the actual value only in local .env or GitHub Actions Secrets.
SUPABASE_SECRET_KEY=

# Legacy server-only key, only needed for older deployments.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Supabase publishable key is for browser/client use and is not needed by the worker.
SUPABASE_PUBLISHABLE_KEY=

# Supabase JWKS endpoint is not required by the price-check worker.
SUPABASE_JWKS_URL=https://kdsqrqrduziqcurmrphl.supabase.co/auth/v1/.well-known/jwks.json

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEMPLATE_NAME=price_drop_alert
WHATSAPP_TEMPLATE_LANGUAGE=id

# Optional worker behavior
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2
USER_AGENT=PersonalPriceTracker/0.1 (personal use; contact: set-your-email)
TIMEZONE=Asia/Jakarta
